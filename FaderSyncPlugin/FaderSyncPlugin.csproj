<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <Version>0.0.0-dev</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Copyright>© Malte Linke</Copyright>
        <Company>NOFEXtreme</Company>
        <Product>GoXLR Fader Sync</Product>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>FaderSync</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NetObsBindings" Version="32.0.0" />
        <ProjectReference Include="..\UtilityClient\UtilityClient.csproj" />
    </ItemGroup>
    
    <Target Name="GeneratePackageLicense" DependsOnTargets="ResolvePackageAssets;ResolveFrameworkReferences">
        <ItemGroup>
            <NoticePack Include="@(ResolvedTargetILCompilerPack)"
                        Condition="'%(ResolvedTargetILCompilerPack.NuGetPackageId)' == 'Microsoft.NETCore.App.Runtime.NativeAOT.$(RuntimeIdentifier)'" />
            <NoticeLibrary Include="@(RuntimeCopyLocalItems)"
                           Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'NetObsBindings' Or
                                      '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'JsonPatch.Net' Or
                                      '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'JsonPointer.Net' Or
                                      '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Json.More.Net'">
                <LicenseFile>%(RuntimeCopyLocalItems.RootDir)%(RuntimeCopyLocalItems.Directory)../../LICENSE</LicenseFile>
            </NoticeLibrary>
            <NoticeLibrary Update="@(NoticeLibrary)" Condition="'%(NoticeLibrary.NuGetPackageId)' == 'NetObsBindings'">
                <LicenseFile>%(NoticeLibrary.LicenseFile).md</LicenseFile>
            </NoticeLibrary>
        </ItemGroup>
        <Error Condition="'@(NoticePack->Count())' != '1' Or '@(NoticeLibrary->Count())' != '4'"
               Text="The required NativeAOT and plugin license inputs were not resolved." />
        <PropertyGroup>
            <NoticePackDirectory>@(NoticePack->'%(PackageDirectory)')</NoticePackDirectory>
            <NoticePackVersion>@(NoticePack->'%(NuGetPackageVersion)')</NoticePackVersion>
            <OriginalLicense>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../LICENSE'))</OriginalLicense>
            <RuntimeLicense>$([System.IO.File]::ReadAllText('$(NoticePackDirectory)/LICENSE.TXT'))</RuntimeLicense>
            <RuntimeNotices>$([System.IO.File]::ReadAllText('$(NoticePackDirectory)/THIRD-PARTY-NOTICES.TXT'))</RuntimeNotices>
        </PropertyGroup>
        <Message Importance="high" Text="Using NativeAOT runtime pack $(RuntimeIdentifier) $(NoticePackVersion) for distribution notices." />
        <WriteLinesToFile File="$(PublishDir)/LICENSE" Overwrite="true"
                          Lines="$([MSBuild]::Escape('$(OriginalLicense)&#xA;&#xA;Third-party notices for GoXLR Fader Sync Plugin&#xA;'))" />
        <WriteLinesToFile File="$(PublishDir)/LICENSE" Overwrite="false"
                          Lines="$([MSBuild]::Escape('&#xA;%(NoticeLibrary.NuGetPackageId) %(NoticeLibrary.NuGetPackageVersion)&#xA;$([System.IO.File]::ReadAllText('%(NoticeLibrary.LicenseFile)'))'))" />
        <WriteLinesToFile File="$(PublishDir)/LICENSE" Overwrite="false"
                          Lines="$([MSBuild]::Escape('&#xA;.NET NativeAOT runtime $(NoticePackVersion)&#xA;$(RuntimeLicense)&#xA;$(RuntimeNotices)'))" />
    </Target>

    <Target Name="Package" AfterTargets="Publish" DependsOnTargets="GeneratePackageLicense"
            Condition="'$(PublishAot)' == 'true' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'linux-x64')">
        <PropertyGroup>
            <PackageDir>$([System.IO.Path]::GetFullPath('$(PublishDir)/../package', '$(MSBuildProjectDirectory)'))</PackageDir>
        </PropertyGroup>
        <ItemGroup>
            <Layout Include="FaderSyncPlugin-win-x64" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
                <Bin>FaderSyncPlugin</Bin>
                <Data>FaderSyncPlugin/data</Data>
                <License>FaderSyncPlugin</License>
            </Layout>
            <Layout Include="FaderSyncPlugin-win-x64-obs32" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
                <Bin>FaderSyncPlugin/bin/64bit</Bin>
                <Data>FaderSyncPlugin/data</Data>
                <License>FaderSyncPlugin</License>
            </Layout>
            <Layout Include="FaderSyncPlugin-win-x64-portable" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
                <Bin>obs-plugins/64bit</Bin>
                <Data>data/obs-plugins/FaderSyncPlugin</Data>
                <License>data/obs-plugins/FaderSyncPlugin</License>
            </Layout>
            <Layout Include="FaderSyncPlugin-linux-x64" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
                <Bin>FaderSyncPlugin/bin/64bit</Bin>
                <Data>FaderSyncPlugin/data</Data>
                <License>FaderSyncPlugin</License>
            </Layout>
        </ItemGroup>
        <RemoveDir Directories="@(Layout->'$(PackageDir)/%(Identity)')" />
        <MakeDir Directories="$(PackageDir)/%(Layout.Identity)/%(Layout.Bin);$(PackageDir)/%(Layout.Identity)/%(Layout.Data)" />
        <Copy SourceFiles="$(PublishDir)/LICENSE" DestinationFolder="$(PackageDir)/%(Layout.Identity)/%(Layout.License)" />
        <Copy SourceFiles="$(PublishDir)/$(AssemblyName)$(NativeBinaryExt)" DestinationFolder="$(PackageDir)/%(Layout.Identity)/%(Layout.Bin)" />
        <ZipDirectory DestinationFile="$(PackageDir)/%(Layout.Identity).zip"
                      SourceDirectory="$(PackageDir)/%(Layout.Identity)" Overwrite="true" />
    </Target>

</Project>
