<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <!-- This Version will be used in CI -->
        <Version>1.4.0-beta.2</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Copyright>© Malte Linke</Copyright>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>FaderSync</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NetObsBindings" Version="32.0.0" />
        <ProjectReference Include="..\UtilityClient\UtilityClient.csproj" />
    </ItemGroup>
    
    <Target Name="Package" AfterTargets="Publish"
            Condition="'$(PublishAot)' == 'true' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'linux-x64')">
        <PropertyGroup>
            <PackageDir>$([System.IO.Path]::GetFullPath('$(PublishDir)/../package', '$(MSBuildProjectDirectory)'))</PackageDir>
        </PropertyGroup>
        <ItemGroup>
            <Layout Include="FaderSyncPlugin-win-x64" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
                <Bin>FaderSyncPlugin</Bin>
                <Data>FaderSyncPlugin/data</Data>
                <License>FaderSyncPlugin</License>
            </Layout>
            <Layout Include="FaderSyncPlugin-win-x64-obs32" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
                <Bin>FaderSyncPlugin/bin/64bit</Bin>
                <Data>FaderSyncPlugin/data</Data>
                <License>FaderSyncPlugin</License>
            </Layout>
            <Layout Include="FaderSyncPlugin-win-x64-portable" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
                <Bin>obs-plugins/64bit</Bin>
                <Data>data/obs-plugins/FaderSyncPlugin</Data>
                <License>data/obs-plugins/FaderSyncPlugin</License>
            </Layout>
            <Layout Include="FaderSyncPlugin-linux-x64" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
                <Bin>FaderSyncPlugin/bin/64bit</Bin>
                <Data>FaderSyncPlugin/data</Data>
                <License>FaderSyncPlugin</License>
            </Layout>
        </ItemGroup>
        <RemoveDir Directories="@(Layout->'$(PackageDir)/%(Identity)')" />
        <MakeDir Directories="$(PackageDir)/%(Layout.Identity)/%(Layout.Bin);$(PackageDir)/%(Layout.Identity)/%(Layout.Data)" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)../LICENSE" DestinationFolder="$(PackageDir)/%(Layout.Identity)/%(Layout.License)" />
        <Copy SourceFiles="$(PublishDir)/$(AssemblyName)$(NativeBinaryExt)" DestinationFolder="$(PackageDir)/%(Layout.Identity)/%(Layout.Bin)" />
        <ZipDirectory DestinationFile="$(PackageDir)/%(Layout.Identity).zip"
                      SourceDirectory="$(PackageDir)/%(Layout.Identity)" Overwrite="true" />
    </Target>

</Project>
